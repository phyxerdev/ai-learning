# Copy this file to .env and fill it in. NEVER commit .env to GitHub.

# --- Ollama (local, free) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:8b
NO_THINK_TAG= /no_think

# --- Gemini (cloud, free tier) ---
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your-gemini-key
# LLM_MODEL=<current gemini flash model name>
# NO_THINK_TAG=

# --- GLM 5.x (Z.ai cloud, paid) ---
# LLM_BASE_URL=https://api.z.ai/api/paas/v4/
# LLM_API_KEY=your-zai-key
# LLM_MODEL=glm-5.2
# NO_THINK_TAG=
